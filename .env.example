# ============================================
# Configuração do Tvheadend
# ============================================
TVHEADEND_URL=http://localhost:9981
TVHEADEND_USERNAME=
TVHEADEND_PASSWORD=

# ============================================
# Configuração das APIs
# ============================================
# Ordem de prioridade das APIs para enriquecimento
# Formato: plex,tmdb,omdb,tvdb (separadas por vírgula, sem espaços)
# APIs disponíveis: plex, plexdb, tvdb, tmdb, omdb
# Exemplo: plex,tmdb,omdb,tvdb
API_PRIORITY_ORDER=plex,tvdb,tmdb,omdb

# Plex API (Principal)
PLEX_URL=http://localhost:32400
PLEX_TOKEN=

# Plex Database (Banco de Dados Local - Gracenote)
# NOTA: Desabilitado por padrão. Ative apenas se tiver configurado corretamente
PLEX_DB_ENABLED=false
PLEX_DB_PATH=/var/lib/plexmediaserver/Library/Application Support/Plex Media Server/Plug-in Support/Databases/com.plexapp.plugins.library.db

# TVDb API (Recomendado - Melhor cobertura de séries)
TVDB_API_KEY=seu_tvdb_api_key
TVDB_PIN=

# TMDb API (Recomendado - Boa cobertura geral)
TMDB_API_KEY=seu_tmdb_api_key

# OMDb API (Opcional - Fallback)
OMDB_API_KEY=

# ============================================
# Agendamento
# ============================================
# Intervalo em horas (ex: 6 para a cada 6 horas, 12 para a cada 12 horas)
SCHEDULE_INTERVAL_HOURS=12

# ============================================
# Saída
# ============================================
# Caminho completo do arquivo de saída XMLTV
OUTPUT_FILE_PATH=/home/ubuntu/xmltv-enricher/output/xmltv.xml

# URL do placeholder para programas sem capa encontrada
PLACEHOLDER_IMAGE_URL=https://raw.githubusercontent.com/seu-usuario/seu-repo/main/placeholder_poster.jpg

# ============================================
# Confiança e Matching
# ============================================
# Algoritmo de fuzzy matching para validação de títulos
# Opções: levenshtein, jaro_winkler, cosine
# Recomendado: jaro_winkler (melhor para nomes)
MATCHING_ALGORITHM=jaro_winkler

# Nível mínimo de confiança para aceitar um match (0-100)
# Recomendado: 85 (bom equilíbrio entre precisão e cobertura)
# Se o match estiver abaixo, tenta a próxima API
# Se nenhuma API atingir o threshold, usa placeholder
CONFIDENCE_THRESHOLD=85

# ============================================
# Cache
# ============================================
# Habilitar cache em memória
CACHE_ENABLED=true

# TTL do cache em horas
CACHE_TTL_HOURS=24

# ============================================
# Logging
# ============================================
# Níveis: error, warn, info, debug
LOG_LEVEL=info

# Caminho do arquivo de log
LOG_FILE=/var/log/xmltv-enricher.log

# Habilitar logging detalhado de URLs das requisições (para debug)
DEBUG_URLS=false

# Quantos programas processar simultaneamente (Recomendado: 3 a 5)
# Se colocar muito alto (ex: 20), o TVDb/TMDb vai bloquear seu IP.
CONCURRENCY_LIMIT=3

# ============================================
# Ambiente
# ============================================
NODE_ENV=production
