# ========================================
# XMLTV Enricher - Exemplo de Configuração
# ========================================
# Copie este arquivo para .env e preencha suas configurações
# cp .env.example .env
# ========================================
 
# ========================================
# TVHEADEND - Configuração do servidor
# ========================================
# URL do servidor TVHeadend (obrigatório)
TVHEADEND_URL=http://localhost:9981
# Usuário para autenticação (opcional, se autenticação estiver habilitada)
TVHEADEND_USERNAME=
# Senha para autenticação (opcional)
TVHEADEND_PASSWORD=

# ========================================
# APIS DE METADADOS
# ========================================
# Chave API do TVDB (https://thetvdb.com/api-information)
TVDB_API_KEY=
TVDB_PIN=
# Chave API do TMDb (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
# Chave API do OMDb (https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=
# Habilitar IMDB como fallback (apenas para títulos sem match nas outras APIs)
IMDB_ENABLED=false
# Idioma para busca de metadados nas APIs (TMDb, TVDb)
# Opções: pt-BR, pt-PT, en-US, en-GB, es-ES, es-MX, fr-FR, de-DE, it-IT, ja-JP, ko-KR, zh-CN
API_LANGUAGE=pt-BR
# URL do servidor Plex
PLEX_URL=http://localhost:32400
# Token do Plex (veja: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/)
PLEX_TOKEN=
# Habilitar acesso direto ao banco de dados do Plex
PLEX_DB_ENABLED=false
# Caminho para o banco de dados do Plex (apenas se PLEX_DB_ENABLED=true)
PLEX_DB_PATH=

# ========================================
# PRIORIDADE DE APIS
# ========================================
# Ordem de consulta das APIs (separado por vírgula)
# Opções: plex, plexdb, tvdb, tmdb, omdb, imdb
API_PRIORITY_ORDER=plex,tvdb,tmdb,omdb

# ========================================
# PROCESSAMENTO
# ========================================
# Intervalo entre execuções automáticas (em horas)
SCHEDULE_INTERVAL_HOURS=12
# Número de requisições paralelas (1-10)
CONCURRENCY_LIMIT=3
# Executar imediatamente ao iniciar (true/false)
RUN_ON_START=false

# ========================================
# CACHE
# ========================================
# Habilitar cache de resultados
CACHE_ENABLED=true
# Tempo de vida do cache (em horas)
CACHE_TTL_HOURS=24

# ========================================
# MATCHING (Correspondência de títulos)
# ========================================
# Algoritmo de matching: jaro_winkler, levenshtein, dice
MATCHING_ALGORITHM=jaro_winkler
# Limiar de confiança (0-100) para aceitar match
CONFIDENCE_THRESHOLD=85

# ========================================
# OUTPUT
# ========================================
# Caminho do arquivo XML de saída
OUTPUT_FILE_PATH=./output/xmltv.xml
# URL de imagem placeholder quando não encontrar capa
PLACEHOLDER_IMAGE_URL=https://via.placeholder.com/300x450?text=Sem+Capa

# ========================================
# LOGGING
# ========================================
# Nível de log: debug, info, warn, error
LOG_LEVEL=info
# Arquivo de log (deixe vazio para apenas console)
LOG_FILE=./logs/xmltv-enricher.log
# Mostrar URLs de debug
DEBUG_URLS=false

# ========================================
# API SERVER (Dashboard)
# ========================================
# Porta do servidor web/dashboard
API_PORT=3000

# ========================================
# BACKUP
# ========================================
# Habilitar backups automáticos
BACKUP_ENABLED=true
# Diretório para backups
BACKUP_DIR=./backups
# Número máximo de backups a manter
MAX_BACKUPS=5

# ========================================
# NOTIFICAÇÕES (Webhook)
# ========================================
# URL do webhook para notificações
WEBHOOK_URL=
# Tipo de webhook: generic, discord, slack, telegram
WEBHOOK_TYPE=generic

# ==========================================
# SEGURANÇA E AUTENTICAÇÃO (OIDC / Pocket ID)
# ==========================================
AUTH_ENABLED=true
# Gere uma string longa e aleatória (ex: 32 caracteres) para assinar os cookies
AUTH_SECRET=236a0143189f979ee28d57298f0c3194a253cc7b66bd825881d46feb4ecb911e
# A URL onde o seu painel é acessado
AUTH_BASE_URL=https://xmltv-enricher.johnflix.com.br/
# Credenciais do Pocket ID
AUTH_CLIENT_ID=johnflix-panel
AUTH_CLIENT_SECRET=Yd25Sg8qTsbF7HIgDRv4S9zS3LIIpZYd
AUTH_ISSUER=https://pocket-id.johnflix.com.br