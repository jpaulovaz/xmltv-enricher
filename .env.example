# ========================================
# XMLTV ENRICHER - CONFIGURAÇÃO
# ========================================

# ----------------------------------------
# TVHEADEND
# ----------------------------------------
TVHEADEND_URL=http://localhost:9981
TVHEADEND_USERNAME=
TVHEADEND_PASSWORD=

# ----------------------------------------
# APIs DE METADADOS
# ----------------------------------------
# TVDb (https://thetvdb.com/)
TVDB_API_KEY=
TVDB_PIN=

# TMDb (https://www.themoviedb.org/)
TMDB_API_KEY=

# OMDb (http://www.omdbapi.com/)
OMDB_API_KEY=

# Plex (opcional)
PLEX_URL=http://localhost:32400
PLEX_TOKEN=
PLEX_DB_ENABLED=false
PLEX_DB_PATH=

# IMDb (web scraping - experimental)
IMDB_ENABLED=false

# ----------------------------------------
# PRIORIDADE DE APIs
# ----------------------------------------
# Ordem de busca nas APIs (separado por vírgulas)
API_PRIORITY_ORDER=plex,tvdb,tmdb,omdb

# ----------------------------------------
# PROCESSAMENTO
# ----------------------------------------
# Intervalo de execução automática (em horas)
SCHEDULE_INTERVAL_HOURS=12

# Número de programas processados simultaneamente
CONCURRENCY_LIMIT=3

# Executar imediatamente ao iniciar (true/false)
RUN_ON_START=true

# ----------------------------------------
# CACHE
# ----------------------------------------
CACHE_ENABLED=true
CACHE_TTL_HOURS=24

# ----------------------------------------
# MATCHING (Correspondência de Títulos)
# ----------------------------------------
# Algoritmo: jaro_winkler, levenshtein, dice
MATCHING_ALGORITHM=jaro_winkler

# Limite de confiança (0-100)
CONFIDENCE_THRESHOLD=85

# ----------------------------------------
# OUTPUT
# ----------------------------------------
# Caminho do arquivo XML final
OUTPUT_FILE_PATH=./output/xmltv.xml

# URL da imagem placeholder (quando não encontrar capa)
PLACEHOLDER_IMAGE_URL=https://via.placeholder.com/300x450?text=Sem+Capa

# ----------------------------------------
# LOGGING
# ----------------------------------------
# Nível: error, warn, info, debug
LOG_LEVEL=info

# Caminho do arquivo de log
LOG_FILE=/var/log/xmltv-enricher.log

# Exibir URLs de requisições (debug)
DEBUG_URLS=false

# ----------------------------------------
# API SERVER (Dashboard e REST API)
# ----------------------------------------
API_PORT=3000

# ----------------------------------------
# BACKUP
# ----------------------------------------
# Habilitar backup automático do XML anterior
BACKUP_ENABLED=true

# Diretório de backups
BACKUP_DIR=./backups

# Número máximo de backups a manter
MAX_BACKUPS=5

# ----------------------------------------
# NOTIFICAÇÕES
# ----------------------------------------
# URL do webhook para notificações
WEBHOOK_URL=

# Tipo: generic, discord, slack
WEBHOOK_TYPE=generic

# Exemplos:
# Discord: https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
# Slack: https://hooks.slack.com/services/YOUR/WEBHOOK/URL
